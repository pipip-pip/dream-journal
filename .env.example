# Copy this file to .env.local for local development.
# In Vercel, add the same names under Project → Settings → Environment Variables.

# From Supabase: Project Settings → API (or "Connect" → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# From https://console.anthropic.com → API Keys. Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model writes the dreams
CLAUDE_MODEL=claude-sonnet-5-5

# Optional but recommended: only this email may generate dreams (extra safety net)
ALLOWED_EMAIL=you@example.com
